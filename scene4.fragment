// Scene extension: all blur and motion are applied at playback, never baked into assets.
const sceneBuffers={};for(const key of ['outdoor','background','blur','mask']){const c=document.createElement('canvas');c.width=960;c.height=540;sceneBuffers[key]=c}
let selectingBlur=false,blurDrag=null;
function applyRegionBlur(ctx,mode,strength){if(strength<=0)return;const copy=sceneBuffers.blur,b=copy.getContext('2d');b.clearRect(0,0,960,540);b.drawImage(ctx.canvas,0,0);ctx.save();ctx.beginPath();if(mode==='custom'){const r=fx.blurRegion;ctx.roundRect(r.x*960,r.y*540,r.w*960,r.h*540,12);ctx.clip()}else if(mode==='edges'){ctx.rect(0,0,960,540);ctx.ellipse(480,285,245,235,0,0,Math.PI*2);ctx.clip('evenodd')}ctx.filter=`blur(${strength}px)`;ctx.drawImage(copy,-strength,-strength,960+strength*2,540+strength*2);ctx.restore()}
function drawPairPiece(ctx,key,side,x,y,w,h){const im=sprites[key];if(!ready(im))return;if(im.src.endsWith('/pair-v2.png')){const half=im.naturalWidth/2;ctx.drawImage(im,half*side,0,half,im.naturalHeight,x,y,w,h)}else contain(ctx,im,x,y,w,h)}
function drawStandingPiece(ctx,side,x,y,w,h,progress){const im=sprites.standing;if(!ready(im)||progress<=0)return;ctx.save();ctx.beginPath();ctx.rect(x-2,y-2,w+4,h*progress+4);ctx.clip();const half=im.naturalWidth/2;ctx.drawImage(im,side*half,0,half,im.naturalHeight,x,y,w,h);ctx.restore()}
function wallFire(ctx,secs,build,style,foreground=false){if(build<=0||fx.fire<=0||!ready(sprites.wisps))return;const im=sprites.wisps,flow=.2+fx.fireSpeed/55;ctx.save();ctx.globalCompositeOperation='screen';ctx.filter=style==='blue'?'hue-rotate(165deg) saturate(1.8) brightness(1.4)':style==='intense'?'brightness(1.75) saturate(1.9)':'saturate(1.6) brightness(1.25)';const bands=foreground?3:4;for(let n=0;n<bands;n++){const phase=secs*flow*(.7+n*.17)+n*2.1;ctx.save();ctx.globalAlpha=build*(fx.fire/100)*(foreground?.3:.48)*(1+.2*Math.sin(phase));const cx=480+Math.sin(phase*.37+n)*130,cy=foreground?460:240+n*54;ctx.translate(cx,cy);ctx.rotate(Math.sin(phase*.3+n)*.2+(n%2?.16:-.12));if(!foreground){ctx.beginPath();ctx.rect(-600,-500,1200,590-cy);ctx.clip()}const width=1100,height=foreground?280:440;for(let j=0;j<18;j++){for(let i=0;i<12;i++){const u=i/12,v=j/18,w=width/12,h=height/18;const dx=Math.sin(phase*1.3+v*8+u*5)*(12+v*14),dy=Math.cos(phase*1.7+u*6-v*9)*9;ctx.drawImage(im,u*im.naturalWidth,v*im.naturalHeight,im.naturalWidth/12,im.naturalHeight/18,-width/2+i*w+dx,-height/2+j*h+dy,w+2,h+2)}}ctx.restore()}ctx.restore()}
const classicFire=drawFire;drawFire=function(ctx,secs,build){if(fx.fireStyle==='classic'||fx.fireStyle==='blue'||fx.fireStyle==='intense')classicFire(ctx,secs,build);else wallFire(ctx,secs,build,fx.fireStyle)};
function renderOutdoor(ctx,secs,d){if(secs<d.outdoor||!ready(sprites.outdoor)||!ready(sprites.standing))return;const age=secs-d.outdoor,q=clamp(age/fx.outdoorReveal),reveal=ease((q-.06)/.82),bg=sceneBuffers.background,b=bg.getContext('2d');b.clearRect(0,0,960,540);cover(b,sprites.outdoor,0,0,960,540);b.save();b.globalAlpha=.85;b.beginPath();b.rect(0,0,960,290);b.clip();drawPairPiece(b,'leftPortrait',0,-40,-80,400,420);drawPairPiece(b,'rightPortrait',1,650,-65,430,430);b.restore();
// Keep factories in front of the giant background cutouts; soften only the composited layer.
if(ready(sprites.outdoor)){b.save();b.beginPath();b.rect(0,245,960,295);b.clip();cover(b,sprites.outdoor,0,0,960,540);b.restore()}if(fx.blurMode==='background')applyRegionBlur(b,'all',fx.blur);
const layer=sceneBuffers.outdoor,c=layer.getContext('2d');c.clearRect(0,0,960,540);c.save();const zoom=1+(fx.outdoorZoom-1)*q;c.translate(480,280);c.scale(zoom,zoom);c.translate(-480,-280);c.drawImage(bg,0,0);c.restore();
// A ragged opening around the first figure expands to sky, feet, then full scene.
const mask=sceneBuffers.mask,m=mask.getContext('2d');m.clearRect(0,0,960,540);m.fillStyle='white';if(q>.96)m.fillRect(0,0,960,540);else tearPath(m,440,270,12+reveal*850,18+reveal*550,7);c.globalCompositeOperation='destination-in';c.drawImage(mask,0,0);c.globalCompositeOperation='source-over';ctx.drawImage(layer,0,0);
const grow=ease(q/.8),size=.22+.78*grow,fullH=435*size,leftX=440-92*size,top=121-grow*65;ctx.save();ctx.globalAlpha=ease(q/.09);drawStandingPiece(ctx,0,leftX,top,158*size,fullH,ease(q/.5));ctx.globalAlpha=ease((q-.18)/.2);drawStandingPiece(ctx,1,leftX+148*size,top+9*size,158*size,fullH,ease((q-.18)/.55));ctx.restore();
const fireVeil=(1-ease((q-.2)/.75))*.9;if(fireVeil>0)wallFire(ctx,secs,fireVeil,fx.fireStyle,true);if(fx.blurMode==='edges'||fx.blurMode==='custom')applyRegionBlur(ctx,fx.blurMode,fx.blur);
}
function drawBlurSelection(ctx,el){if(el!==base||activeEffect!=='blur'||fx.blurMode!=='custom')return;const r=fx.blurRegion;ctx.save();ctx.strokeStyle='#d8c3ff';ctx.lineWidth=2;ctx.setLineDash([8,5]);ctx.strokeRect(r.x*960,r.y*540,r.w*960,r.h*540);ctx.fillStyle='#c7adff18';ctx.fillRect(r.x*960,r.y*540,r.w*960,r.h*540);ctx.restore()}
