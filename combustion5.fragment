const combustionEngine=new FlameEngine();let flameVideo=null,videoObjectUrl=null;
const roofMask=document.createElement('canvas');roofMask.width=960;roofMask.height=540;const roofPortraits=document.createElement('canvas');roofPortraits.width=960;roofPortraits.height=540;let roofMaskKey='';
function composeRoofPortraits(b){if(!ready(sprites.outdoor))return;if(roofMaskKey!==sprites.outdoor.src){roofMaskKey=sprites.outdoor.src;const m=roofMask.getContext('2d');m.clearRect(0,0,960,540);m.drawImage(b.canvas,0,0);const data=m.getImageData(0,0,960,540).data;m.clearRect(0,0,960,540);m.fillStyle='white';for(let x=0;x<960;x++){let run=0,boundary=300;for(let y=35;y<360;y++){const i=(y*960+x)*4,r=data[i],g=data[i+1],blue=data[i+2],sky=(blue>r*1.06&&blue>g*.92)||(r>188&&g>190&&blue>194);run=sky?0:run+1;if(run>=7){boundary=y-6;break}}m.fillRect(x,0,1,boundary)}}const p=roofPortraits.getContext('2d');p.clearRect(0,0,960,540);p.globalCompositeOperation='source-over';p.globalAlpha=.88;drawPairPiece(p,'leftPortrait',0,-45,-145,400,420);drawPairPiece(p,'rightPortrait',1,650,-135,430,430);p.globalAlpha=1;p.globalCompositeOperation='destination-in';p.drawImage(roofMask,0,0);p.globalCompositeOperation='source-over';b.drawImage(roofPortraits,0,0)}
function emberParticles(ctx,seconds,strength){if(strength<=0||fx.sparks<=0)return;ctx.save();ctx.globalCompositeOperation='screen';const count=Math.floor(fx.sparks*1.3),velocity=.5+fx.fireSpeed/100,wild=fx.wildness/100;for(let i=0;i<count;i++){const life=(Math.max(0,seconds)*(.1+noise(i,52)*.18)*velocity+noise(i,53))%1,age=life*(1.5+noise(i,59)*2),x0=190+noise(i,55)*570,y0=340+noise(i,56)*13;const x=x0+(noise(i,57)-.5)*life*80+Math.sin(seconds*(.7+noise(i,58))+i)*life*wild*45+fx.wind*life,y=y0-age*(45+noise(i,60)*55)-age*age*8;const alpha=(1-life)*strength*(.4+noise(i,62)*.6),radius=.5+noise(i,63)*1.6;ctx.globalAlpha=alpha;ctx.strokeStyle=fx.fireStyle==='blue'?'#a5ddff':fx.fireColor;ctx.lineWidth=radius;ctx.beginPath();ctx.moveTo(x,y);ctx.lineTo(x-(noise(i,57)-.5)*3,y+radius*(2+wild*5));ctx.stroke();if(i%6===0){ctx.globalAlpha=alpha*.18;ctx.fillStyle=ctx.strokeStyle;ctx.beginPath();ctx.arc(x,y,radius*3,0,Math.PI*2);ctx.fill()}}ctx.restore()}
function liveCombustion(ctx,seconds,strength){if(strength<=0||fx.fire<=0)return;ctx.save();ctx.globalCompositeOperation='screen';ctx.globalAlpha=strength;
if(fx.fireSource==='video'&&flameVideo&&flameVideo.readyState>=2){const desired=Math.max(0,seconds)%Math.max(.1,flameVideo.duration||1);if(!flameVideo.seeking&&Math.abs(flameVideo.currentTime-desired)>.18)flameVideo.currentTime=desired;ctx.filter=`hue-rotate(${hueShift(fx.fireColor)}deg) saturate(1.2)`;ctx.drawImage(flameVideo,100,20,760,340);ctx.filter='none'}else{const image=combustionEngine.render(Math.max(0,seconds),fx);if(image)ctx.drawImage(image,0,0,960,540);else if(ready(sprites.firePoster)){ctx.globalAlpha=strength*.65;ctx.drawImage(sprites.firePoster,0,0,960,355)}}ctx.restore();emberParticles(ctx,seconds,strength)}
drawFire=liveCombustion;wallFire=function(ctx,seconds,strength){liveCombustion(ctx,seconds,strength)};
async function attachFireVideo(src){if(!flameVideo){flameVideo=document.createElement('video');flameVideo.muted=true;flameVideo.loop=true;flameVideo.playsInline=true;flameVideo.preload='auto';flameVideo.addEventListener('error',()=>{const s=document.querySelector('#videoStatus');if(s)s.textContent='This file cannot play here. Try MP4 (H.264) or WebM.'})}flameVideo.src=src;flameVideo.load();fx.fireSource='video';flameVideo.addEventListener('loadeddata',()=>{document.querySelectorAll('.scene').forEach(el=>el._renderKey='');const status=document.querySelector('#videoStatus');if(status)status.textContent='Real footage ready. Black backgrounds blend away automatically.'},{once:true});localStorage.setItem('motion-effects',JSON.stringify(fx))}
assetDB().then(db=>{const r=db.transaction('assets').objectStore('assets').get('fireVideo');r.onsuccess=()=>{if(r.result)attachFireVideo(r.result);db.close()}}).catch(()=>{});
