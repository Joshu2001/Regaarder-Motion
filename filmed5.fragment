// Included photographed flames. Credit: Artur Szczubelek / Pexels, video 11977692.
const filmedFire=document.createElement('video');filmedFire.src='assets/real-fire.mp4';filmedFire.muted=true;filmedFire.loop=true;filmedFire.playsInline=true;filmedFire.preload='auto';
for(const event of ['loadeddata','seeked'])filmedFire.addEventListener(event,()=>{document.querySelectorAll('.scene').forEach(el=>el._renderKey='');if(typeof refreshPosters==='function')refreshPosters()});
if(!localStorage.getItem('filmed-fire-v1')){if(fx.fireSource!=='video')fx.fireSource='stock';localStorage.setItem('filmed-fire-v1','1');localStorage.setItem('motion-effects',JSON.stringify(fx))}
function photographedFire(ctx,seconds,strength,video){if(video.readyState<2)return false;const wild=fx.wildness/100,rate=Math.min(2.5,.45+fx.fireSpeed/100+wild*.6),desired=Math.max(0,seconds)*rate%Math.max(.1,video.duration||20);if(!video.seeking&&Math.abs(video.currentTime-desired)>.35)video.currentTime=desired;video.playbackRate=rate;if(playing&&video.paused)video.play().catch(()=>{});if(!playing&&!video.paused)video.pause();const iw=video.videoWidth,ih=video.videoHeight,h=(150+fx.fire*1.9)*(.9+wild*.18);ctx.save();ctx.globalCompositeOperation='screen';ctx.globalAlpha=strength;const shift=fx.fireStyle==='blue'?hueShift(fx.fireColor):hueShift(fx.fireColor);ctx.filter=`hue-rotate(${shift}deg) saturate(${fx.fireStyle==='vivid'?1.65:1.15}) brightness(${fx.fireStyle==='intense'?1.35:1})`;ctx.drawImage(video,iw*.13,ih*.12,iw*.78,ih*.665,55,356-h,850,h);if(fx.fireStyle==='intense'||fx.fireStyle==='wall'){ctx.globalAlpha=strength*(fx.fireStyle==='intense'?.6:.35);ctx.save();ctx.translate(960,0);ctx.scale(-1,1);ctx.drawImage(video,iw*.25,ih*.18,iw*.6,ih*.59,0,355-h*.88,960,h*.88);ctx.restore()}ctx.globalAlpha=strength*.85;ctx.drawImage(video,iw*.22,ih*.18,iw*.3,ih*.59,-60,550-h*.82,240,h*.82);ctx.drawImage(video,iw*.52,ih*.18,iw*.3,ih*.59,800,550-h*.9,240,h*.9);ctx.restore();return true}
