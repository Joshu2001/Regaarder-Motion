#### Controls and compatibility

```json
{
  "adapter": "expansion",
  "preview": {
    "availability": "Add & preview in the composition editor"
  },
  "capabilities": {
    "playback": "Shared blank-layer clock: speed, reverse, delay, pause, easing, slow/fast",
    "parameters": "Independent per-instance copies; nested JSON editable",
    "media": "Independent named source-slot bindings",
    "direction": "Timing reversal; geometric axes only where implemented",
    "geometry": "Images remain planes; full unseen object reconstruction is not implemented."
  },
  "slots": [
    "salvageFacade",
    "salvageGround",
    "salvageSearcher",
    "salvageBrownShoe",
    "salvageCreamShoe",
    "salvageSky",
    "routeShoeA",
    "routeShoeB",
    "routeShoeC",
    "routeShoeD",
    "salvageRubble",
    "salvageGrayLeg",
    "salvagePinkLeg",
    "historyMotherBackground",
    "historyMotherPerson",
    "historyMotherVase",
    "historyRoomBackground",
    "historyRoomPerson",
    "historyRoomVase",
    "historyRoomCloth",
    "warFire",
    "walkAtlas",
    "hybridGround",
    "stagingRoom",
    "stagingShelf",
    "stagingStreet",
    "stagingSoldier"
  ],
  "commonPlayback": {
    "speed": 1,
    "reverse": false,
    "delay": 0,
    "pauseAt": 0.5,
    "pauseFor": 0,
    "ease": "linear",
    "slowFast": false,
    "slowStart": 0.3,
    "slowEnd": 0.65,
    "slowSpeed": 0.35,
    "fastSpeed": 2
  }
}
```

